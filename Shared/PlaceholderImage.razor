@inject NavigationManager Nav

@if (!string.IsNullOrWhiteSpace(ResolvedImageUrl) && !_imageFailed)
{
    <img class="node-image" src="@ResolvedImageUrl" alt="@Title" @onerror="HandleImageError" />
}
else
{
    <div class="node-image node-image-placeholder" style="@GradientStyle">
        <span>@Initials</span>
    </div>
}

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter, EditorRequired] public string Seed { get; set; } = "";
    [Parameter] public string? ImageUrl { get; set; }

    private static readonly string[] DefaultImageUrls =
    [
        "images/cards/body-balancing.png",
        "images/cards/emotion-stability.png",
        "images/cards/energy.png",
        "images/cards/category-2.png",
        "images/cards/category-3.png",
        "images/cards/category-4.png",
        "images/cards/category-5.png",
        "images/cards/category-6.png"
    ];

    private bool _imageFailed;
    private string? _resolvedImageUrl;

    protected override void OnParametersSet()
    {
        var nextImageUrl = ResolveImageUrl(GetCandidateImageUrl());
        if (!string.Equals(_resolvedImageUrl, nextImageUrl, StringComparison.Ordinal))
        {
            _imageFailed = false;
            _resolvedImageUrl = nextImageUrl;
        }
    }

    private string? ResolvedImageUrl =>
        _resolvedImageUrl;

    private string Initials =>
        BuildInitials(Title);

    private string GradientStyle
    {
        get
        {
            var hue1 = HashToHue(Seed);
            var hue2 = (hue1 + 40) % 360;
            return $"background: linear-gradient(135deg, hsl({hue1}, 62%, 45%), hsl({hue2}, 70%, 34%));";
        }
    }

    private static string BuildInitials(string title)
    {
        var words = title
            .Split(new[] { ' ', '-', '_', '.' }, StringSplitOptions.RemoveEmptyEntries)
            .Where(w => w.Length > 0)
            .ToList();

        if (words.Count == 0)
        {
            return "?";
        }

        if (words.Count == 1)
        {
            return words[0].Length >= 2
                ? words[0].Substring(0, 2).ToUpperInvariant()
                : words[0].Substring(0, 1).ToUpperInvariant();
        }

        return string.Concat(words.Take(2).Select(w => char.ToUpperInvariant(w[0])));
    }

    private string GetCandidateImageUrl()
    {
        if (!string.IsNullOrWhiteSpace(ImageUrl))
        {
            return ImageUrl;
        }

        return DefaultImageUrls[HashToHue(Seed) % DefaultImageUrls.Length];
    }

    private string? ResolveImageUrl(string? imageUrl)
    {
        if (string.IsNullOrWhiteSpace(imageUrl))
        {
            return null;
        }

        var trimmed = imageUrl.Trim();
        if (Uri.TryCreate(trimmed, UriKind.Absolute, out var absolute))
        {
            return absolute.ToString();
        }

        return Nav.ToAbsoluteUri(trimmed.TrimStart('/')).ToString();
    }

    private void HandleImageError()
    {
        _imageFailed = true;
    }

    private static int HashToHue(string seed)
    {
        unchecked
        {
            var hash = 23;
            foreach (var c in seed)
            {
                hash = hash * 31 + c;
            }
            return Math.Abs(hash) % 360;
        }
    }
}
